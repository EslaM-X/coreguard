{
  "name": "coreguard",
  "version": "0.1.0",
  "description": "Verifiable Execution Truth Layer for Bitcoin DeFi on Core — execution evidence protocol (CGEP/1 Draft)",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "benchmark": "node test/adversarial/benchmark-runner.js",
    "benchmark:10k": "node scripts/benchmark-10k.mjs",
    "benchmark:dde": "node scripts/benchmark-dde.mjs",
    "benchmark:dde-http": "node scripts/benchmark-dde-http.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "prepush": "node scripts/pre-push-check.mjs",
    "release:dry": "node scripts/release-please.mjs --dry-run",
    "mutation": "node scripts/mutation-lab.mjs",
    "corpus": "node benchmarks/generate-corpus.js",
    "analyze": "node packages/cli/src/index.js analyze",
    "verify": "node packages/cli/src/index.js verify",
    "verify-run": "node packages/cli/src/index.js verify-run",
    "verify-provenance": "node packages/cli/src/index.js verify-provenance",
    "report": "node packages/cli/src/index.js report",
    "demo": "node examples/transfer/run-demo.js",
    "demo:swap": "node examples/swap/run-demo.js",
    "demo:multistep": "node examples/multistep/run-demo.js",
    "demo:90s": "node submission/demo-90s/run-demo-90s.mjs --offline",
    "demo:90s:live": "node submission/demo-90s/run-demo-90s.mjs",
    "demo:90s:killer": "node scripts/demo-killer-90s.mjs",
    "demo:vault": "node examples/vault/vault-demo.mjs --allow",
    "demo:attack": "node examples/vault/vault-demo.mjs --attack",
    "create:integration": "node scripts/create-integration.mjs",
    "evidence-package": "node scripts/make-evidence-package.mjs --out evidence-package-output",
    "dispute-package": "node scripts/make-dispute-package.mjs --case A --out dispute-package-output",
    "peoples-court:prepare": "node packages/peoples-court-adapter/cli.mjs",
    "peoples-court:harness": "node packages/peoples-court-adapter/cli-harness.mjs",
    "ladder:status": "node scripts/ladder/cli.mjs",
    "ladder:passport": "node scripts/ladder/evidence-passport.mjs",
    "ladder:passport:write": "node scripts/ladder/evidence-passport.mjs --write",
    "ladder:passport:print": "node scripts/ladder/evidence-passport.mjs --print",
    "ladder:conformance": "node scripts/ladder/conformance.mjs",
    "ladder:dashboard": "node scripts/ladder/adoption-dashboard.mjs",
    "ladder:dashboard:write": "node scripts/ladder/adoption-dashboard.mjs --write",
    "ladder:findings": "node scripts/ladder/risk-findings.mjs",
    "ladder:findings:write": "node scripts/ladder/risk-findings.mjs --write",
    "ladder:reputation": "node scripts/ladder/reputation.mjs",
    "ladder:reputation:write": "node scripts/ladder/reputation.mjs --write",
    "boundary:audit": "node scripts/boundary-audit.mjs",
    "aea1:prepare": "node packages/agentic-escrow-arbitration/cli.mjs",
    "live": "node examples/live/live-verify.js",
    "anchor": "powershell -ExecutionPolicy Bypass -File scripts/anchor-local.ps1",
    "anchor:plan": "node scripts/compute-commitment.mjs --out scripts/live-anchor-planned.json",
    "anchor:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-anchor.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EslaM-X/coreguard.git"
  },
  "homepage": "https://github.com/EslaM-X/coreguard",
  "keywords": [
    "bitcoin-defi",
    "core-blockchain",
    "execution-verification",
    "security",
    "evidence",
    "btc-fi",
    "cgep"
  ],
  "license": "MIT",
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
