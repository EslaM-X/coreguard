# Byte-exact preservation for assurance evidence trees (hash-verified)
coreguard-assurance/** -text
coreguard-assurance-v4.2.2-remediation/** -text
legacy-quarantine/** -text

# Byte-exact preservation for verifier-c (Dec-C-9 self-checksum): the loader
# re-hashes its own sources at import and fails closed on any byte change,
# including EOL rewriting by core.autocrlf. Policy: docs/eol-policy.md
packages/verifier-c/** -text

# Byte-exact preservation for verbatim RPC evidence (evidence/raw/): manifest
# pins SHA-256 per dump; CRLF rewriting would break a fresh-clone re-hash.
evidence/raw/** -text

# Byte-exact preservation for the whole evidence tree (derived results + raw):
# keeps reproduce-from-clone step byte-exact (result JSON re-generation diff).
evidence/** -text
