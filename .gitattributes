# Byte-exact preservation for assurance evidence trees (hash-verified)
coreguard-assurance/** -text
coreguard-assurance-v4.2.2-remediation/** -text
legacy-quarantine/** -text

# Byte-exact preservation for verifier-c (Dec-C-9 self-checksum): the loader
# re-hashes its own sources at import and fails closed on any byte change,
# including EOL rewriting by core.autocrlf. Policy: docs/eol-policy.md
packages/verifier-c/** -text

# Byte-exact preservation for verbatim RPC evidence (evidence/raw/): manifest
# pins SHA-256 per dump; CRLF rewriting would break a fresh-clone re-hash.
evidence/raw/** -text

# Byte-exact preservation for the whole evidence tree (derived results + raw):
# keeps reproduce-from-clone step byte-exact (result JSON re-generation diff).
evidence/** -text

# Byte-exact preservation for the frozen bilingual dashboard (freeze-record
# pins ../docs/GOVERNANCE-DASHBOARD.html): system core.autocrlf=true made a
# fresh Windows clone rewrite it to CRLF on disk -> --disk verification failed
# for reviewers. -text keeps clean-clone bytes identical to the committed pin.
docs/GOVERNANCE-DASHBOARD.html -text

# Byte-exact preservation for the bilingual session boards (freeze-record pins
# docs/coreguard-gate41-visual*.html): same rationale as the dashboard above —
# core.autocrlf=true on fresh Windows clones would rewrite bytes and break
# pinned-hash verification. Policy: docs/eol-policy.md
docs/coreguard-gate41-visual.html -text
docs/coreguard-gate41-visual-en.html -text

# Contract test files must hash identically on any machine that verifies
# them (the workflow YAML contract is itself a gate): pin bytes, no rewrite.
test/ci/workflow-yaml-contract.test.js -text

# Byte-exact preservation for the committed git hooks (.githooks/pre-push):
# with core.autocrlf=true the working copy would turn LF into CRLF and the
# bundled POSIX shell would choke on the \r ("command not found") — meaning
# the settle guard would silently stop running on Windows. -text keeps every
# clone's hook bytes LF, so the guard runs identically everywhere.
.githooks/** -text
