{
  "name": "coreguard",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "coreguard",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@coreguard/canonical": {
      "resolved": "packages/canonical",
      "link": true
    },
    "node_modules/@coreguard/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@coreguard/evidence": {
      "resolved": "packages/evidence",
      "link": true
    },
    "node_modules/@coreguard/intent": {
      "resolved": "packages/intent",
      "link": true
    },
    "node_modules/@coreguard/policy": {
      "resolved": "packages/policy",
      "link": true
    },
    "node_modules/@coreguard/trace": {
      "resolved": "packages/trace",
      "link": true
    },
    "node_modules/@coreguard/verifier": {
      "resolved": "packages/verifier",
      "link": true
    },
    "packages/canonical": {
      "name": "@coreguard/canonical",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/cli": {
      "name": "@coreguard/cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "coreguard": "src/index.js"
      }
    },
    "packages/evidence": {
      "name": "@coreguard/evidence",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/intent": {
      "name": "@coreguard/intent",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/policy": {
      "name": "@coreguard/policy",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/trace": {
      "name": "@coreguard/trace",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/verifier": {
      "name": "@coreguard/verifier",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
